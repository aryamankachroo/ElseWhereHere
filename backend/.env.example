# Copy this file to backend/.env and fill in real values. backend/.env is gitignored.

# xAI key for Grok answers and source lookup (https://console.x.ai). Server-side only:
# never put it in the frontend .env.local, because Vite bakes VITE_* values into the app.
XAI_API_KEY=

# Optional. Any xAI model that supports the web_search tool.
# XAI_MODEL=grok-4.7
