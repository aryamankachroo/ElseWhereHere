# Copy this file to .env.local and fill in real values as needed.
# .env.local is gitignored; never commit real tokens.

# Set to "false" to score matches through the local FastAPI server.
# Defaults to the in-browser scorer when unset. The API must be running:
# .venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000
VITE_USE_MOCK_API=false

# Only used by the live adapter. Leave unset to use relative /api/v1/* URLs
# against the same origin the frontend is served from.
# VITE_API_BASE_URL=https://api.example.com

# Public (browser-restricted) Mapbox token — see docs/mapbox for scope and
# URL-restriction guidance. Never put a secret token here.
# VITE_MAPBOX_ACCESS_TOKEN=pk.your-public-token
